# Mycelium Unified Environment Configuration
# For docker-compose-unified.yml

# ═══════════════════════════════════════════════════════════════════════════
# 🔐 SECURITY & PASSWORDS
# ═══════════════════════════════════════════════════════════════════════════

# PostgreSQL - My-app
POSTGRES_PASSWORD=your-secure-postgres-password-change-me

# PostgreSQL - Central
DB_USER=admin
DB_PASSWORD=your-secure-db-password-change-me

# Redis
REDIS_PASSWORD=your-redis-password-change-me

# ═══════════════════════════════════════════════════════════════════════════
# 📰 WORDPRESS
# ═══════════════════════════════════════════════════════════════════════════

WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=your-wordpress-db-password-change-me
WORDPRESS_DB_ROOT_PASSWORD=your-wordpress-root-password-change-me

# ═══════════════════════════════════════════════════════════════════════════
# 🔍 BASEROW
# ═══════════════════════════════════════════════════════════════════════════

BASEROW_ADMIN_EMAIL=admin@mycelium.local
BASEROW_ADMIN_PASSWORD=your-baserow-admin-password-change-me

# ═══════════════════════════════════════════════════════════════════════════
# 🌍 ENVIRONMENT
# ═══════════════════════════════════════════════════════════════════════════

NODE_ENV=production
LOG_LEVEL=info

# ═══════════════════════════════════════════════════════════════════════════
# 🔗 INGRESS
# ═══════════════════════════════════════════════════════════════════════════

CADDY_DOMAIN=mycelium.local
CADDY_EMAIL=admin@mycelium.local
