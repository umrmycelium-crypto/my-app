# Mycelium Deployment Environment
# Update these for production

# My-App Database
POSTGRES_PASSWORD=change-me-production
POSTGRES_HOST=my-app-postgres
POSTGRES_PORT=5432
POSTGRES_DB=visiondb

# Central Database
DB_USER=admin
DB_PASSWORD=change-me-production
DB_HOST=postgres-central
DB_PORT=5432
DB_NAME=mycelium

# Redis
REDIS_HOST=redis-central
REDIS_PORT=6379
REDIS_PASSWORD=

# Services
NODE_ENV=production
LOG_LEVEL=info

# Milvus Vector DB
MILVUS_HOST=memsys-milvus-standalone
MILVUS_PORT=19530

# Elasticsearch
ELASTICSEARCH_HOST=memsys-elasticsearch
ELASTICSEARCH_PORT=9200

# MongoDB
MONGODB_HOST=memsys-mongodb
MONGODB_PORT=27017
MONGODB_DB=mycelium

# Caddy/Ingress
CADDY_DOMAIN=mycelium.example.com
CADDY_EMAIL=admin@example.com
