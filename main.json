{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.41.2.15936",
      "templateHash": "8330878291775248628"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "eastus"
    },
    "rgName": {
      "type": "string",
      "defaultValue": "vision-platform-rg"
    },
    "postgresAdmin": {
      "type": "string",
      "defaultValue": "pgadmin"
    },
    "postgresPassword": {
      "type": "securestring",
      "defaultValue": "REPLACE_WITH_STRONG_PASSWORD"
    }
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2021-04-01",
      "name": "[toLower(format('visionblob{0}', uniqueString(resourceGroup().id)))]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard_LRS"
      },
      "kind": "StorageV2"
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers",
      "apiVersion": "2021-06-01",
      "name": "vision-pg",
      "location": "[parameters('location')]",
      "properties": {
        "version": "13",
        "administratorLogin": "[parameters('postgresAdmin')]",
        "administratorLoginPassword": "[parameters('postgresPassword')]",
        "storage": {
          "storageSizeGB": 128
        }
      },
      "sku": {
        "name": "GP_Gen5_2",
        "tier": "GeneralPurpose",
        "capacity": 2
      }
    },
    {
      "type": "Microsoft.Cache/redis",
      "apiVersion": "2021-06-01",
      "name": "vision-redis",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard",
        "family": "C",
        "capacity": 1
      }
    }
  ],
  "outputs": {
    "storageAccountName": {
      "type": "string",
      "value": "[toLower(format('visionblob{0}', uniqueString(resourceGroup().id)))]"
    },
    "postgresHost": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.DBforPostgreSQL/flexibleServers', 'vision-pg'), '2021-06-01').fullyQualifiedDomainName]"
    },
    "redisHost": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Cache/redis', 'vision-redis'), '2021-06-01').hostName]"
    }
  }
}